# MemoMind Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# LLM Provider Configuration
# =============================================================================

# Choose your LLM provider: anthropic, openai, or ollama
MEMOMIND_LLM_PROVIDER=anthropic

# Anthropic Claude API Key (required if using anthropic provider)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxx

# OpenAI API Key (required if using openai provider)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxx

# Ollama Configuration (for local models)
# Make sure Ollama is running: ollama serve
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# =============================================================================
# Authentication Settings
# =============================================================================

# Authentication method: api_key or oauth
# - api_key: Use API key directly (from env or config)
# - oauth: Use OAuth login (run: memomind auth login)
MEMOMIND_LLM_AUTH_METHOD=api_key

# OAuth callback port for local server (default: 8642)
MEMOMIND_AUTH_OAUTH_CALLBACK_PORT=8642

# =============================================================================
# Social Platform OAuth Settings (Optional)
# =============================================================================
# These are configured via CLI: memomind auth configure --provider <platform>
# Alternatively, you can set them here:

# 抖音/Douyin - Get credentials at: https://open.douyin.com/
# MEMOMIND_DOUYIN_CLIENT_KEY=
# MEMOMIND_DOUYIN_CLIENT_SECRET=

# 快手/Kuaishou - Get credentials at: https://open.kuaishou.com/
# MEMOMIND_KUAISHOU_CLIENT_ID=
# MEMOMIND_KUAISHOU_CLIENT_SECRET=

# 小红书/Xiaohongshu - Get credentials at: https://open.xiaohongshu.com/
# MEMOMIND_XIAOHONGSHU_CLIENT_ID=
# MEMOMIND_XIAOHONGSHU_CLIENT_SECRET=

# =============================================================================
# Model Settings
# =============================================================================

# Model to use (depends on provider)
# Anthropic: claude-sonnet-4-20250514, claude-opus-4-20250514, etc.
# OpenAI: gpt-4-turbo, gpt-4o, gpt-3.5-turbo, etc.
# Ollama: llama2, mistral, codellama, etc.
MEMOMIND_LLM_MODEL=claude-sonnet-4-20250514

# Temperature for LLM responses (0.0 - 1.0)
MEMOMIND_LLM_TEMPERATURE=0.7

# Maximum tokens for LLM responses
MEMOMIND_LLM_MAX_TOKENS=4096

# =============================================================================
# Embedding Settings
# =============================================================================

# Embedding provider: local or openai
MEMOMIND_EMBEDDING_PROVIDER=local

# Local embedding model (sentence-transformers)
# Options: all-MiniLM-L6-v2, all-mpnet-base-v2, etc.
MEMOMIND_EMBEDDING_MODEL=all-MiniLM-L6-v2

# =============================================================================
# Storage Settings
# =============================================================================

# Base directory for MemoMind data (default: ~/.memomind)
# MEMOMIND_DATA_DIR=~/.memomind

# =============================================================================
# Memory Settings
# =============================================================================

# Maximum messages to keep in short-term memory
MEMOMIND_MEMORY_SHORT_TERM_MAX=20

# Number of memories to retrieve for context
MEMOMIND_MEMORY_RETRIEVAL_TOP_K=5

# Importance threshold for persisting to long-term memory (0.0 - 1.0)
MEMOMIND_MEMORY_IMPORTANCE_THRESHOLD=0.6

# =============================================================================
# Knowledge Base Settings
# =============================================================================

# Chunk size for text splitting (characters)
MEMOMIND_KNOWLEDGE_CHUNK_SIZE=500

# Chunk overlap (characters)
MEMOMIND_KNOWLEDGE_CHUNK_OVERLAP=50
