# Copy to deploy/.env and fill in. Never commit the real stream key.

# YouTube Studio -> Go live -> Stream -> Stream key (keep it secret).
YOUTUBE_STREAM_KEY=xxxx-xxxx-xxxx-xxxx-xxxx

# Optional: a full ingest URL instead (e.g. the backup ingest). Overrides the key above.
# SANDSCROLL_RTMP_URL=rtmps://b.rtmps.youtube.com:443/live2?backup=1/xxxx-xxxx-xxxx-xxxx-xxxx

# Picture and encoding. 1080p30 at ~6.8 Mbps suits YouTube's 1080p ingest guidance.
SANDSCROLL_WIDTH=1920
SANDSCROLL_HEIGHT=1080
SANDSCROLL_FPS=30
SANDSCROLL_VIDEO_BITRATE=6800k
SANDSCROLL_AUDIO_BITRATE=192k
SANDSCROLL_X264_PRESET=veryfast
# The artist's hand over the table: low (default, keeps 1080p30 real time on 4 cores), high, off.
# SANDSCROLL_HAND=low

# Seed: leave unset to change the performance every day (seed = days since 1970).
# SANDSCROLL_SEED=2026

# Running order (comma separated scene ids) overrides program.json.
# SANDSCROLL_PROGRAM=title,moonrise,greatwall,voyage1784,goldengate,pandas,rosegarden,finale,pinecrane,plum,riverboat,bamboo
